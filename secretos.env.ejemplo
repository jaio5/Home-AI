# Ajustes del companero. Este archivo NO va al repositorio.
# Se lee solo al arrancar, y NO pisa lo que ya venga en el entorno.
#
# La misma ficha tiene que estar en el PC y en el servidor: copia este archivo
# a la maquina Ubuntu tal cual.

# ---- la ficha del agente --------------------------------------------------
# Lo unico que impide que cualquiera de la red le mande recados a tu PC.
BUDDY_AGENTE_FICHA=<LA-FICHA-LARGA>

# ---- solo en el SERVIDOR Ubuntu -------------------------------------------
# Donde esta el agente. Descomentalo alli; aqui, en el PC, tiene que quedarse
# comentado o el servidor se mandaria los recados a si mismo dando vueltas.
#BUDDY_AGENTE=http://192.168.3.16:8788

# Donde esta Ollama. Vacio = se busca solo en local (IPv4 y luego IPv6).
#BUDDY_OLLAMA=http://127.0.0.1:11434

# Las credenciales de Spotify, si no esta el proyecto del reloj al lado.
#BUDDY_SPOTIFY_SECRETS=/home/javier/secretos/spotify.h
