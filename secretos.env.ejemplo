# Ajustes del companero. Copia esto a "secretos.env" y rellena los huecos.
#
# secretos.env esta en .gitignore y es el UNICO sitio donde van las claves.
# Este archivo de ejemplo si va al repositorio, que es publico: aqui nunca se
# pega un valor de verdad. Hay un hook de git que lo comprueba antes de cada
# commit (se activa con: git config core.hooksPath .githooks).
#
# Se lee solo al arrancar y NO pisa lo que ya venga en el entorno: si exportas
# una variable a mano, gana la tuya.

# ---- la ficha del agente --------------------------------------------------
# Lo unico que impide que cualquiera de la red le mande recados a tu PC. Tiene
# que ser la MISMA en el PC y en el servidor.
# Para inventarte una:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
BUDDY_AGENTE_FICHA=<UNA-CADENA-LARGA-Y-DIFICIL>

# ---- como se llama ---------------------------------------------------------
# Hay que decir su nombre para que empiece a atenderte, y "adios" o "hasta
# luego" para que se calle. Cambialo por el que quieras.
#
# Elige uno que Whisper pueda oir bien: dos silabas, que suene a palabra
# espanola y que no se confunda con algo que digas a menudo. "Nova", "Aira",
# "Lumo" van bien; iniciales sueltas o nombres en ingles, mal.
BUDDY_NOMBRE=Nova

# Segundos despierto sin oir nada antes de volver a dormirse.
#BUDDY_ESPERA_DORMIR=90

# ---- Spotify --------------------------------------------------------------
# El refresh token es una credencial VIVA: con el se entra a tu cuenta sin
# contrasena y no caduca hasta que lo revoques. Si alguna vez se te escapa, se
# quita desde https://www.spotify.com/account/apps/
#
# Se sacan con tools/spotify_auth.py del proyecto del reloj. Con PKCE no hace
# falta client secret.
BUDDY_SPOTIFY_CLIENT_ID=<EL-CLIENT-ID>
BUDDY_SPOTIFY_REFRESH_TOKEN=<EL-REFRESH-TOKEN>

# ---- solo en el SERVIDOR Ubuntu -------------------------------------------
# Donde esta el agente del PC. Descomentalo alli; en el propio PC tiene que
# quedarse comentado, o el servidor se mandaria los recados a si mismo dando
# vueltas.
#BUDDY_AGENTE=http://192.168.1.50:8788

# Donde esta Ollama. Vacio = se busca solo en local, IPv4 y luego IPv6.
#BUDDY_OLLAMA=http://127.0.0.1:11434

# En que puerto escucha el agente, si el 8788 te viene mal.
#BUDDY_AGENTE_PUERTO=8788
